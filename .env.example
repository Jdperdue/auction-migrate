# Source database (René Bates)
SOURCE_HOST=
SOURCE_PORT=3306
SOURCE_DB=admin_live
SOURCE_USER=
SOURCE_PASS=

# René Bates per-auction photo folders (bates{NNN}/), local to this server
SOURCE_PHOTOS_DIR=/var/www/admin_live/auctions

# René Bates flat client logo directory (logo_{client_id:%06d}.jpg), local to this server
SOURCE_LOGOS_DIR=/var/www/logos

# Target database (auction platform)
TARGET_HOST=127.0.0.1
TARGET_PORT=3306
TARGET_DB=auction
TARGET_USER=auctionuser
TARGET_PASS=

# Target app's public storage disk root (storage/app/public)
TARGET_STORAGE_DIR=/var/www/auction/storage/app/public

# Migration config
TENANT_ID=
DRY_RUN=false
BATCH_SIZE=500
LOG_FILE=logs/migration.log

# System user ID recorded as author/recorded_by on migrated notes,
# deposit transactions, etc. Must exist in the target `users` table.
MIGRATION_SYSTEM_USER_ID=
